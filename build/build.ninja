  description = CC(ee) $out
rule ee_cxx
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ee/bin/mips64r5900el-ps2-elf-g++.exe $flags -c $in -o $out
  description = CXX(ee) $out
rule iop_cc
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/iop/bin/mipsel-none-elf-gcc.exe $flags -c $in -o $out
  description = CC(iop) $out
rule ee_link
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ee/bin/mips64r5900el-ps2-elf-gcc.exe -T$linkfile -o $out $in $flags $libs
  description = LINK(ee) $out
rule ee_link_cxx
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ee/bin/mips64r5900el-ps2-elf-g++.exe -T$linkfile -o $out $in $flags $libs
  description = LINK(ee,c++) $out
rule iop_link
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/iop/bin/mipsel-none-elf-gcc.exe -T$linkfile -o $out $in $flags $libs
  description = LINK(iop) $out
rule iop_strip
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/iop/bin/mipsel-none-elf-strip.exe $flags -o $out $in
  description = STRIP $out
rule iop_fixup
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ps2sdk/bin/iopfixup $flags -o $out $in
  description = IOPFIXUP $out
rule bin2c
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ps2sdk/bin/bin2c.exe $in $out $varname
  description = BIN2C $out
rule ee_objcopy
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ee/bin/mips64r5900el-ps2-elf-objcopy.exe -O binary $in $out
  description = OBJCOPY $out
rule ee_ar
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ee/bin/mips64r5900el-ps2-elf-ar.exe rcs $out $in
  description = AR(ee) $out
rule iop_ar
  command = D:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/iop/bin/mipsel-none-elf-ar.exe rcs $out $in
  description = AR(iop) $out

build obj/romfs/src/romfs.o: ee_cc D$:/_PLATFORMS/PLAYSTATION/PS2DEV/romfs/src/romfs.c
  flags = -D_EE$ -G0$ -O2$ -Wall$ -ffunction-sections$ -ID:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ps2sdk/ee/include$ -ID:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ps2sdk/common/include$ -ID:/_PLATFORMS/PLAYSTATION/PS2DEV/romfs/include$ -ID:/_PLATFORMS/PLAYSTATION/PS2DEV/romfs/src$ -DSYS_LITTLE_ENDIAN$ -DSYS_NEED_ALIGNMENT
build obj/romfs/src/romfs_io.o: ee_cc D$:/_PLATFORMS/PLAYSTATION/PS2DEV/romfs/src/romfs_io.c
  flags = -D_EE$ -G0$ -O2$ -Wall$ -ffunction-sections$ -ID:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ps2sdk/ee/include$ -ID:/_PLATFORMS/PLAYSTATION/PS2DEV/toolchain/ps2sdk/common/include$ -ID:/_PLATFORMS/PLAYSTATION/PS2DEV/romfs/include$ -ID:/_PLATFORMS/PLAYSTATION/PS2DEV/romfs/src$ -DSYS_LITTLE_ENDIAN$ -DSYS_NEED_ALIGNMENT
build lib/libromfs.a: ee_ar obj/romfs/src/romfs.o obj/romfs/src/romfs_io.o

